---
import ConceptPicker from '@/components/ConceptPicker.astro';
---
<div id="txedit-overlay" class="overlay" aria-hidden="true">
  <div class="modal" role="dialog" aria-modal="true" aria-labelledby="txedit-title">
    <div class="modal-handle"></div>

    <div class="modal-header">
      <div>
        <h2 id="txedit-title" class="modal-title">Editar ingreso</h2>
        <p id="txedit-subtitle" class="modal-subtitle">modifica los datos del cobro</p>
      </div>
      <button id="txedit-close" type="button" class="modal-close" aria-label="Cerrar">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M18 6L6 18M6 6l12 12" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/>
        </svg>
      </button>
    </div>

    <form id="txedit-form" novalidate>
      <div class="amount-area">
        <label class="amount-label" for="txedit-amount">Importe *</label>
        <div class="amount-wrap">
          <span class="currency-sym" aria-hidden="true">$</span>
          <input id="txedit-amount" type="text" inputmode="numeric" autocomplete="off"
            class="amount-input" placeholder="0" aria-describedby="txedit-amount-msg" />
        </div>
        <span id="txedit-amount-msg" class="field-msg"></span>
      </div>

      <div class="modal-body">
        <input type="hidden" id="txedit-id" />
        <input type="hidden" id="txedit-type" />
        <input type="hidden" id="txedit-vehicle" />

        <ConceptPicker prefix="txedit" />

        <div class="grid-1">
          <div class="field">
            <label for="txedit-date">Fecha *</label>
            <input id="txedit-date" type="date" class="field-input" aria-describedby="txedit-date-msg" />
            <span id="txedit-date-msg" class="field-msg"></span>
          </div>
        </div>

        <div class="field no-border">
          <label for="txedit-notes">Notas <span class="optional">· opcional</span></label>
          <input id="txedit-notes" type="text" maxlength="300" class="field-input" />
        </div>
      </div>

      <div class="modal-actions">
        <button id="txedit-delete" type="button" class="btn-delete">Eliminar</button>
        <button id="txedit-submit" type="submit" class="btn-save">Guardar</button>
      </div>
    </form>
  </div>
</div>

<style>
  .overlay {
    position: fixed; inset: 0;
    display: flex; align-items: flex-end;
    z-index: 200;
    opacity: 0; pointer-events: none;
    transition: opacity 0.2s ease, background-color 0.2s ease;
    background: rgba(30, 80, 30, 0.3);
  }
  .overlay.open { opacity: 1; pointer-events: all; }
  .overlay.expense { background: rgba(80, 20, 20, 0.3); }

  .modal {
    background: white; width: 100%; max-width: 480px;
    margin: 0 auto;
    border-radius: 24px 24px 0 0;
    padding-bottom: calc(1.25rem + env(safe-area-inset-bottom));
    transform: translateY(100%);
    transition: transform 0.25s cubic-bezier(0.32, 0.72, 0, 1);
  }
  .overlay.open .modal { transform: translateY(0); }

  .modal-handle { width: 32px; height: 3px; border-radius: 99px; margin: 14px auto 0; background: #C0DD97; transition: background 0.2s; }
  .overlay.expense .modal-handle { background: #F7C1C1; }

  .modal-header { display: flex; justify-content: space-between; align-items: flex-start; padding: 16px 18px 0; }

  .modal-title { font-family: var(--font-display); font-size: 22px; font-weight: 700; line-height: 1; color: var(--color-income); transition: color 0.2s; }
  .overlay.expense .modal-title { color: var(--color-expense); }

  .modal-subtitle { font-family: var(--font-mono); font-size: 9px; color: #6B6A63; letter-spacing: 0.06em; margin-top: 4px; }

  .modal-close {
    width: 36px; height: 36px; border-radius: 50%;
    background: var(--color-income-light); border: none;
    display: flex; align-items: center; justify-content: center;
    cursor: pointer; color: var(--color-income);
    flex-shrink: 0; margin-top: 2px; transition: background 0.2s, color 0.2s;
  }
  .overlay.expense .modal-close { background: var(--color-expense-light); color: var(--color-expense); }


  .amount-area { padding: 14px 18px; border-bottom: 0.5px solid #f3f3f3; }
  .amount-label { font-family: var(--font-mono); font-size: 9px; color: #6B6A63; letter-spacing: 0.08em; text-transform: uppercase; margin-bottom: 6px; }
  .amount-wrap  { display: flex; align-items: baseline; gap: 4px; }

  .currency-sym { font-family: var(--font-mono); font-size: 22px; font-weight: 500; color: var(--color-income); transition: color 0.2s; }
  .overlay.expense .currency-sym { color: var(--color-expense); }

  .amount-input {
    font-family: var(--font-mono); font-size: 32px; font-weight: 500;
    border: none; outline: none; background: transparent; width: 100%;
    color: var(--color-income); transition: color 0.2s;
  }
  .overlay.expense .amount-input { color: var(--color-expense); }
  .amount-input::placeholder { color: #e5e7eb; }

  .modal-body { padding: 4px 18px 0; display: flex; flex-direction: column; }

  .field { padding: 13px 0; border-bottom: 0.5px solid #f3f3f3; }
  .field.no-border { border-bottom: none; }
  .field label { font-family: var(--font-mono); font-size: 9px; color: #6B6A63; letter-spacing: 0.08em; text-transform: uppercase; display: block; margin-bottom: 5px; }
  .optional { color: var(--color-muted); font-size: 9px; text-transform: none; letter-spacing: 0; }

  .field-input { border: none; outline: none; font-family: var(--font-sans); font-size: 15px; color: var(--color-carbon); background: transparent; width: 100%; padding: 0; appearance: none; }
  .field-input::placeholder { color: #d1d5db; }

  .grid-2 { display: grid; grid-template-columns: 1fr 1fr; border-bottom: 0.5px solid #f3f3f3; }
  .grid-2 .field { border-bottom: none; padding: 13px 0; }
  .grid-2 .field:first-child { border-right: 0.5px solid #f3f3f3; padding-right: 14px; }
  .grid-2 .field:last-child { padding-left: 14px; }

  .modal-actions { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; padding: 14px 18px 0; }

  .btn-delete {
    padding: 13px; border-radius: 12px;
    font-family: var(--font-sans); font-size: 13px; font-weight: 600;
    background: var(--color-expense-light); color: var(--color-expense);
    border: none; cursor: pointer; transition: opacity 0.15s;
  }
  .btn-delete:hover { opacity: 0.8; }

  .btn-save {
    padding: 13px; border-radius: 12px;
    font-family: var(--font-sans); font-size: 13px; font-weight: 600;
    color: white; border: none; cursor: pointer;
    display: flex; align-items: center; justify-content: center; gap: 6px;
    background: var(--color-income); transition: background 0.2s;
  }
  .overlay.expense .btn-save { background: var(--color-expense); }
  .btn-save:disabled { opacity: 0.65; cursor: not-allowed; }


  .amount-label { display: block; }
  .btn-delete, .btn-save { min-height: 48px; }
</style>
<script>
  import {
    api, toast, flashToast, setButtonState, setFieldError, clearFieldErrors,
    formatAmountInput, parseAmount, reloadWithLoading, wait,
  } from '@/scripts/ui';
  import { conceptPicker } from '@/scripts/concept-picker';

  type TxType = 'income' | 'expense';

  const overlay    = document.getElementById('txedit-overlay')!;
  const form       = document.getElementById('txedit-form') as HTMLFormElement;
  const titleEl    = document.getElementById('txedit-title')!;
  const subtitleEl = document.getElementById('txedit-subtitle')!;
  const btnClose   = document.getElementById('txedit-close')!;
  const btnDelete  = document.getElementById('txedit-delete') as HTMLButtonElement;
  const btnSubmit  = document.getElementById('txedit-submit') as HTMLButtonElement;
  const concept    = conceptPicker('txedit');

  const fields = {
    id:          document.getElementById('txedit-id')          as HTMLInputElement,
    type:        document.getElementById('txedit-type')        as HTMLInputElement,
    amount:      document.getElementById('txedit-amount')      as HTMLInputElement,
    vehicle:     document.getElementById('txedit-vehicle')     as HTMLInputElement,
    date:        document.getElementById('txedit-date')        as HTMLInputElement,
    notes:       document.getElementById('txedit-notes')       as HTMLInputElement,
  };

  const config = {
    income:  { title: 'Editar ingreso', subtitle: 'modifica los datos del cobro', saved: 'Ingreso actualizado' },
    expense: { title: 'Editar gasto',   subtitle: 'modifica los datos del pago',  saved: 'Gasto actualizado'   },
  };

  let submitted   = false;
  let description = ''; // descripción original, para el aviso de borrado
  let busy      = false;

  document.addEventListener('open-tx-edit', (e: Event) => {
    const data = (e as CustomEvent).detail;
    const type: TxType = data.type;

    overlay.classList.toggle('expense', type === 'expense');
    titleEl.textContent    = config[type].title;
    subtitleEl.textContent = config[type].subtitle;

    fields.id.value          = data.id;
    fields.type.value        = type;
    fields.amount.value      = String(Math.round(Number(data.amount)));
    formatAmountInput(fields.amount);
    description              = data.description;
    fields.vehicle.value     = data.vehicleId;
    fields.date.value        = data.date; // YYYY-MM-DD
    fields.notes.value       = data.notes ?? '';
    concept.setType(type);
    concept.value            = data.category ?? '';

    submitted = false;
    clearFieldErrors(form);

    setButtonState(btnSubmit, 'idle', 'Guardar');
    btnDelete.disabled = false;
    overlay.classList.add('open');
    overlay.setAttribute('aria-hidden', 'false');
    fields.amount.focus();
  });

  function closeModal() {
    if (busy) return;
    overlay.classList.remove('open');
    overlay.setAttribute('aria-hidden', 'true');
  }

  function validate(): boolean {
    const errors: [HTMLElement, string][] = [
      [fields.amount,      parseAmount(fields.amount.value) > 0 ? '' : 'Introduce un importe mayor que 0.'],
      [concept.input,      concept.value ? '' : 'Elige un concepto de la lista.'],
      [fields.date,        fields.date.value ? '' : 'Indica la fecha.'],
    ];
    errors.forEach(([el, msg]) => setFieldError(el, msg));
    const first = errors.find(([, msg]) => msg);
    first?.[0].focus();
    return !first;
  }

  fields.amount.addEventListener('input', () => { formatAmountInput(fields.amount); if (submitted) validate(); });
  fields.date.addEventListener('change', () => { if (submitted) validate(); });
  concept.root.addEventListener('concept-change', () => { if (submitted) validate(); });

  btnClose.addEventListener('click', closeModal);
  overlay.addEventListener('click', (e) => { if (e.target === overlay) closeModal(); });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && overlay.classList.contains('open')) closeModal();
  });

  // Eliminar: la lista oculta el movimiento y ofrece "Deshacer" (ver TransactionListPage)
  btnDelete.addEventListener('click', () => {
    if (busy) return;
    const detail = { id: fields.id.value, description };
    closeModal();
    document.dispatchEvent(new CustomEvent('tx-delete', { detail }));
  });

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (busy) return;
    submitted = true;
    if (concept.input.value.trim()) concept.commit();
    if (!validate()) return;

    busy = true;
    btnDelete.disabled = true;
    setButtonState(btnSubmit, 'loading', 'Guardando…');

    const res = await api('/api/transactions/update', 'PUT', {
      id:          fields.id.value,
      amount:      parseAmount(fields.amount.value),
      description: concept.label,
      vehicleId:   fields.vehicle.value,
      date:        fields.date.value,
      notes:       fields.notes.value.trim() || undefined,
      category:    concept.value,
    });

    if (!res.ok) {
      busy = false;
      btnDelete.disabled = false;
      setButtonState(btnSubmit, 'idle', 'Guardar');
      toast({
        kind:  'error',
        title: res.offline ? 'Sin conexión' : 'No se pudo guardar',
        body:  res.offline ? 'Los cambios se pueden guardar cuando vuelvas a tener red.' : res.error,
      });
      return;
    }

    setButtonState(btnSubmit, 'done', 'Guardado');
    await wait(600);
    flashToast({ kind: 'success', title: config[fields.type.value as TxType].saved });
    reloadWithLoading();
  });
</script>
