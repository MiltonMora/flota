---
import AppLayout from '@/layouts/AppLayout.astro';
import TransactionModal from '@/components/TransactionModal.astro';
import TransactionEditModal from '@/components/TransactionEditModal.astro';
import ListSkeleton from '@/components/ListSkeleton.astro';
import EmptyState from '@/components/EmptyState.astro';
import ErrorState from '@/components/ErrorState.astro';
import DateRangePicker from '@/components/DateRangePicker.astro';
import { categoryLabel } from '@/lib/categories';
import { db } from '@/db';
import { transactions, vehicles, userVehicles } from '@/db/schema';
import { rangeFromParams, monthRange, toISODay, formatDay, currency } from '@/lib/dates';
import { eq, desc, sql, and, gte, lte, inArray } from 'drizzle-orm';

interface Props {
  type: 'income' | 'expense';
}

const { type } = Astro.props;
const user     = Astro.locals.user;

const copy = {
  income: {
    title: 'Ingresos', fab: 'Nuevo ingreso', sign: '+', noun: 'ingresos',
    emptyText: 'Registra viajes, fletes o cobros para ver cuánto produce cada vehículo.',
    emptyAction: 'Registrar primer ingreso',
  },
  expense: {
    title: 'Gastos', fab: 'Nuevo gasto', sign: '−', noun: 'gastos',
    emptyText: 'Registra combustible, peajes o mantenimiento para ver el balance real de cada vehículo.',
    emptyAction: 'Registrar primer gasto',
  },
}[type];

const hasRange = Astro.url.searchParams.has('from');
const { from, toEnd, fromISO, toISO } = rangeFromParams(Astro.url.searchParams);
const monthName  = formatDay(from, { month: 'long', year: 'numeric' });
const monthLabel = monthName.charAt(0).toUpperCase() + monthName.slice(1);

// Enlace "Ver mes anterior" para el estado vacío
const prev = monthRange(from, -1);
const prevMonthHref = `${Astro.url.pathname}?from=${toISODay(prev.from)}&to=${toISODay(prev.to)}`;

let userVehicleList: { id: string; plate: string; brand: string; model: string }[] = [];
let loadError = false;
let total = 0;
let list: {
  id: string; amount: number; description: string; notes: string | null;
  category: string | null; date: Date; plate: string; vehicleId: string;
}[] = [];

try {
  userVehicleList = await db
    .select({ id: vehicles.id, plate: vehicles.plate, brand: vehicles.brand, model: vehicles.model })
    .from(userVehicles)
    .innerJoin(vehicles, eq(userVehicles.vehicleId, vehicles.id))
    .where(eq(userVehicles.userId, user.id));

  const vehicleIds = userVehicleList.map((v) => v.id);

  if (vehicleIds.length > 0) {
  const where = and(
    inArray(transactions.vehicleId, vehicleIds),
    eq(transactions.type, type),
    gte(transactions.date, from),
    lte(transactions.date, toEnd),
  );

  const [totals] = await db
    .select({ total: sql<number>`COALESCE(SUM(${transactions.amount}), 0)` })
    .from(transactions)
    .where(where);

  total = totals?.total ?? 0;

  list = await db
    .select({
      id:          transactions.id,
      amount:      transactions.amount,
      description: transactions.description,
      notes:       transactions.notes,
      category:    transactions.category,
      date:        transactions.date,
      plate:       vehicles.plate,
      vehicleId:   transactions.vehicleId,
    })
    .from(transactions)
    .innerJoin(vehicles, eq(transactions.vehicleId, vehicles.id))
    .where(where)
    .orderBy(desc(transactions.date));
  }
} catch (err) {
  console.error(`[${type}] error cargando movimientos`, err);
  loadError = true;
}

const hasVehicles = userVehicleList.length > 0;
---

<AppLayout title={`${copy.title} · Flota Vial`}>
  <div class={`page is-${type}`}>

    <header class="page-header">
      <p class="kicker">movimientos</p>
      <h1 class="title">{copy.title}</h1>
    </header>

    <!-- Resumen del período -->
    <div class="summary-row">
      <div class="summary-card">
        <p class="summary-label">Total período</p>
        <p id="summary-total" class="summary-val accent" data-total={total} data-sk-text>{loadError ? '—' : currency(total)}</p>
      </div>
      <div class="summary-card">
        <p class="summary-label">Registros</p>
        <p id="summary-count" class="summary-val count" data-count={list.length} data-sk-text>{loadError ? '—' : list.length}</p>
      </div>
    </div>

    <!-- Filtro de fechas -->
    <form method="GET" class="filter-form">
      <div class="filter-bar">
        <a href={Astro.url.pathname} class={`chip ${!hasRange ? 'chip-active' : ''}`}>
          Este mes
        </a>
        <button type="button" id="btn-range" class={`chip ${hasRange ? 'chip-active' : ''}`} aria-expanded={hasRange ? 'true' : 'false'} aria-controls="range-inputs">
          Por rango
        </button>
      </div>

      <div id="range-inputs" class={`range-inputs ${hasRange ? 'open' : ''}`}>
        <DateRangePicker from={fromISO} to={toISO} tone={type} />
      </div>
    </form>

    <p class="period-label">{monthLabel}</p>

    <!-- Lista -->
    <ListSkeleton count={Math.min(Math.max(list.length, 3), 6)} />

    <div id="pending-list" class="list" data-loading-hide data-type={type}></div>

    <div class="list" data-loading-hide>
      {loadError ? (
        <ErrorState title={`No pudimos cargar los ${copy.noun}`} />
      ) : !hasVehicles ? (
        <EmptyState
          tone={type}
          icon="car"
          title="Primero añade un vehículo"
          text={`Los ${copy.noun} se registran por vehículo.`}
          linkLabel="Ir a vehículos"
          linkHref="/vehicles"
        />
      ) : list.length === 0 ? (
        <div id="empty-wrap">
          <EmptyState
            tone={type}
            title={`Sin ${copy.noun} en ${monthLabel}`}
            text={copy.emptyText}
            actionLabel={copy.emptyAction}
            actionId="empty-action"
            linkLabel="Ver mes anterior"
            linkHref={prevMonthHref}
          />
        </div>
      ) : (
        list.map((tx) => (
            <div class="tx-card" data-tx-id={tx.id} data-amount={tx.amount}>
              <div class="tx-left">
                <p class="tx-desc">{tx.description}</p>
                <div class="tx-meta">
                  <span class="badge-plate">{tx.plate}</span>
                  {tx.category && categoryLabel(tx.category) !== tx.description && (
                    <span class="badge-concept">{categoryLabel(tx.category)}</span>
                  )}
                  <span>{formatDay(tx.date)}</span>
                </div>
              </div>
              <div class="tx-right">
                <p class="tx-amount">{copy.sign}{currency(tx.amount)}</p>
                <button
                  class="edit-btn"
                  data-id={tx.id}
                  data-type={type}
                  data-amount={tx.amount}
                  data-description={tx.description}
                  data-notes={tx.notes ?? ''}
                  data-category={tx.category ?? ''}
                  data-vehicle-id={tx.vehicleId}
                  data-date={toISODay(tx.date)}
                  aria-label={`Editar ${tx.description}`}
                >
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none">
                    <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                    <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                  </svg>
                </button>
              </div>
            </div>
          ))
      )}
    </div>

  </div>

  <!-- FAB -->
  <button id="fab" class={`fab is-${type}`} data-type={type} aria-label={copy.fab} hidden={!hasVehicles}>
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none">
      <path d="M12 5v14M5 12h14" stroke="white" stroke-width="2" stroke-linecap="round"/>
    </svg>
  </button>

  <TransactionModal vehicles={userVehicleList} />
  <TransactionEditModal vehicles={userVehicleList} />
</AppLayout>

<style>
  .is-income  { --accent: var(--color-income);  --accent-light: var(--color-income-light);  }
  .is-expense { --accent: var(--color-expense); --accent-light: var(--color-expense-light); }

  .page {
    padding: 1.25rem 1.25rem calc(6rem + env(safe-area-inset-bottom));
    display: flex;
    flex-direction: column;
    gap: 1rem;
    min-height: 100dvh;
    background: var(--color-asphalt);
  }

  .kicker {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--accent);
    letter-spacing: 0.05em;
    margin-bottom: 2px;
    opacity: 0.7;
  }

  .title {
    font-family: var(--font-display);
    font-size: 2rem;
    font-weight: 700;
    color: var(--accent);
    line-height: 1;
  }

  .summary-row   { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
  .summary-card  { background: white; border-radius: 10px; padding: 12px 14px; border: 0.5px solid #e5e7eb; }
  .summary-label { font-family: var(--font-mono); font-size: 9px; color: #6B6A63; letter-spacing: 0.06em; text-transform: uppercase; margin-bottom: 5px; }
  .summary-val   { font-family: var(--font-mono); font-size: 18px; font-weight: 500; }
  .summary-val.accent { color: var(--accent); }
  .is-income  .summary-val.count { color: var(--color-navy); }
  .is-expense .summary-val.count { color: var(--color-expense); }

  /* Filtro */
  .filter-form { display: flex; flex-direction: column; gap: 8px; }
  .filter-bar  { display: flex; gap: 8px; }

  .chip {
    font-family: var(--font-mono);
    font-size: 10px;
    min-height: 40px;
    display: inline-flex;
    align-items: center;
    padding: 0 16px;
    border-radius: 99px;
    border: 0.5px solid #e5e7eb;
    background: white;
    color: #6B6A63;
    cursor: pointer;
    text-decoration: none;
    transition: all 0.15s;
  }
  .chip-active { background: var(--accent); color: white; border-color: var(--accent); }

  .range-inputs { display: none; flex-direction: column; background: white; border-radius: 12px; padding: 14px; border: 0.5px solid #e5e7eb; }
  .range-inputs.open { display: flex; }


  .period-label {
    font-family: var(--font-mono);
    font-size: 10px;
    color: #6B6A63;
    letter-spacing: 0.05em;
  }

  /* Lista */
  .list { display: flex; flex-direction: column; gap: 8px; }

  .list :global(.tx-card) {
    background: white;
    border-radius: 10px;
    padding: 12px 14px;
    border: 0.5px solid #e5e7eb;
    display: flex;
    justify-content: space-between;
    align-items: center;
    transition: opacity 0.15s;
  }
  .list :global(.tx-card:hover) { opacity: 0.8; }
  .list :global(.tx-card[hidden]) { display: none; }

  .list :global(.tx-left)  { flex: 1; min-width: 0; }
  .list :global(.tx-right) { display: flex; align-items: center; gap: 10px; flex-shrink: 0; }

  .edit-btn {
    width: 44px; height: 44px; border-radius: 10px;
    background: var(--accent-light); color: var(--accent);
    border: none; cursor: pointer;
    display: flex; align-items: center; justify-content: center;
    transition: opacity 0.15s;
  }

  .list :global(.tx-desc) {
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 600;
    color: var(--color-carbon);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .badge-concept {
    background: var(--accent-light); color: var(--color-carbon);
    padding: 2px 6px; border-radius: 4px; white-space: nowrap;
  }
  .list :global(.tx-meta) {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 4px 6px;
    margin-top: 4px;
    font-family: var(--font-mono);
    font-size: 10px;
    color: #6B6A63;
  }

  .list :global(.tx-amount) {
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 500;
    white-space: nowrap;
    margin-left: 12px;
    color: var(--accent);
  }


  /* FAB */
  .fab {
    position: fixed;
    bottom: calc(5rem + env(safe-area-inset-bottom));
    right: 1.25rem;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4px 14px rgba(0,0,0,0.18);
    transition: opacity 0.15s, transform 0.15s;
    z-index: 50;
    background: var(--accent);
  }
  .fab[hidden] { display: none; }
  .fab:hover  { opacity: 0.9; transform: scale(1.05); }
  .fab:active { transform: scale(0.95); }
</style>

<script>
  import { api, toast, getPendingTx, formatCurrency, type PendingTx } from '@/scripts/ui';

  const btnRange    = document.getElementById('btn-range')!;
  const rangeInputs = document.getElementById('range-inputs')!;
  const fab         = document.getElementById('fab')!;
  const pendingList = document.getElementById('pending-list')!;
  const pageType    = pendingList.dataset.type as 'income' | 'expense';
  const sign        = pageType === 'income' ? '+' : '−';

  btnRange.addEventListener('click', () => {
    const open = rangeInputs.classList.toggle('open');
    btnRange.setAttribute('aria-expanded', String(open));
    btnRange.classList.toggle('chip-active');
    document.querySelector('.filter-bar a.chip')?.classList.remove('chip-active');
  });

  const openCreate = () =>
    document.dispatchEvent(new CustomEvent('open-tx-modal', { detail: { type: pageType } }));

  fab.addEventListener('click', openCreate);
  document.getElementById('empty-action')?.addEventListener('click', openCreate);

  document.querySelectorAll<HTMLElement>('.edit-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const d = btn.dataset;
      document.dispatchEvent(new CustomEvent('open-tx-edit', {
        detail: {
          id:          d.id,
          type:        d.type,
          amount:      d.amount,
          description: d.description,
          notes:       d.notes,
          category:    d.category,
          vehicleId:   d.vehicleId,
          date:        d.date,
        }
      }));
    });
  });

  // ── Resumen (se ajusta al borrar sin recargar) ──
  const totalEl = document.getElementById('summary-total')!;
  const countEl = document.getElementById('summary-count')!;

  function adjustSummary(amount: number, count: number) {
    const total = Number(totalEl.dataset.total ?? 0) + amount;
    const n     = Number(countEl.dataset.count ?? 0) + count;
    totalEl.dataset.total = String(total);
    countEl.dataset.count = String(n);
    totalEl.textContent   = formatCurrency(total);
    countEl.textContent   = String(n);
  }

  // ── Borrado con "Deshacer": se oculta ya y se envía al expirar el aviso ──
  const pendingDeletes = new Set<string>();

  document.addEventListener('tx-delete', (e: Event) => {
    const { id, description } = (e as CustomEvent<{ id: string; description: string }>).detail;
    const card = document.querySelector<HTMLElement>(`.tx-card[data-tx-id="${CSS.escape(id)}"]`);
    if (!card) return;

    const amount = Number(card.dataset.amount ?? 0);
    card.hidden = true;
    adjustSummary(-amount, -1);
    pendingDeletes.add(id);

    const restore = () => {
      pendingDeletes.delete(id);
      card.hidden = false;
      adjustSummary(amount, 1);
    };

    toast({
      kind:   'info',
      title:  'Movimiento eliminado',
      body:   description,
      action: {
        label: 'DESHACER',
        onClick: () => {
          restore();
          toast({ kind: 'success', title: 'Movimiento restaurado', duration: 2500 });
        },
      },
      onExpire: async () => {
        if (!pendingDeletes.delete(id)) return;
        const res = await api('/api/transactions/delete', 'DELETE', { id });
        if (res.ok) { card.remove(); return; }
        restore();
        toast({ kind: 'error', title: 'No se pudo eliminar', body: res.error });
      },
    });
  });

  // Si el usuario sale antes de que expire el aviso, se envía igualmente
  window.addEventListener('pagehide', () => {
    for (const id of pendingDeletes) {
      fetch('/api/transactions/delete', {
        method: 'DELETE',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id }),
        keepalive: true,
      });
    }
    pendingDeletes.clear();
  });

  // ── Movimientos guardados sin conexión (pendientes de sincronizar) ──
  function renderPending(items: PendingTx[]) {
    pendingList.replaceChildren(...items
      .filter((p) => p.data.type === pageType)
      .map((p) => {
        const card = document.createElement('div');
        card.className = 'tx-card is-pending';

        const left = document.createElement('div');
        left.className = 'tx-left';
        const desc = document.createElement('p');
        desc.className   = 'tx-desc';
        desc.textContent = p.data.description;
        const meta = document.createElement('div');
        meta.className = 'tx-meta';
        const plate = document.createElement('span');
        plate.className   = 'badge-plate';
        plate.textContent = p.plate;
        const badge = document.createElement('span');
        badge.className   = 'badge-pending';
        badge.textContent = 'pendiente de sincronizar';
        meta.append(plate, badge);
        left.append(desc, meta);

        const amount = document.createElement('p');
        amount.className   = 'tx-amount';
        amount.textContent = `${sign}${formatCurrency(p.data.amount)}`;

        const right = document.createElement('div');
        right.className = 'tx-right';
        right.append(amount);

        card.append(left, right);
        return card;
      }));

    // Con pendientes, el estado vacío sobra
    const empty = document.getElementById('empty-wrap');
    if (empty) empty.hidden = pendingList.childElementCount > 0;
  }

  renderPending(getPendingTx());
  document.addEventListener('pending-tx-change', (e: Event) =>
    renderPending((e as CustomEvent<PendingTx[]>).detail));
</script>
