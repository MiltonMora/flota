---
import { isAdmin } from '@/lib/admin';

const currentPath = Astro.url.pathname;

const navItems = [
  { href: '/dashboard',            label: 'Inicio',   icon: 'home'    },
  { href: '/vehicles',         label: 'Vehículo', icon: 'car'     },
  { href: '/transactions/income',  label: 'Ingreso',  icon: 'income'  },
  { href: '/transactions/expense', label: 'Gasto',    icon: 'expense' },
  { href: '/reports',              label: 'Informes', icon: 'reports' },
  ...(isAdmin(Astro.locals.user?.email) ? [{ href: '/admin/users', label: 'Usuarios', icon: 'users' }] : []),
];

const isActive = (href: string) =>
  currentPath === href || currentPath.startsWith(`${href}/`);
---

<nav class="mobile-nav" aria-label="Principal">
  {navItems.map((item) => (
    <a href={item.href} class={`nav-item ${isActive(item.href) ? 'active' : ''}`} aria-current={isActive(item.href) ? 'page' : undefined}>

      <span class={`nav-icon icon-${item.icon}`}>
        {item.icon === 'home' && (
          <svg viewBox="0 0 24 24" fill="none">
            <path d="M3 10.5L12 3l9 7.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M5 9.5V20h14V9.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        )}
        {item.icon === 'car' && (
          <svg viewBox="0 0 24 24" fill="none">
            <path d="M5 16l1-5h12l1 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
            <path d="M7 16h10" stroke="currentColor" stroke-width="1.8"/>
            <circle cx="8" cy="18" r="1.5" fill="currentColor"/>
            <circle cx="16" cy="18" r="1.5" fill="currentColor"/>
          </svg>
        )}
        {item.icon === 'income' && (
          <svg viewBox="0 0 24 24" fill="none">
            <path d="M12 19V5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
            <path d="M7 10l5-5 5 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        )}
        {item.icon === 'reports' && (
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M4 20V10M10 20V4M16 20v-7M22 20H2" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
          </svg>
        )}
        {item.icon === 'users' && (
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <circle cx="9" cy="8" r="3.5" stroke="currentColor" stroke-width="1.8"/>
            <path d="M2.5 20c.8-3.6 3.3-5.5 6.5-5.5s5.7 1.9 6.5 5.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
            <path d="M16 4.8a3.5 3.5 0 010 6.4M18.5 14.8c1.6.8 2.6 2.5 3 5.2" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
          </svg>
        )}
        {item.icon === 'expense' && (
          <svg viewBox="0 0 24 24" fill="none">
            <path d="M12 5v14" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
            <path d="M17 14l-5 5-5-5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        )}
      </span>

      <span class="nav-label">{item.label}</span>

    </a>
  ))}
</nav>

<style>
  .mobile-nav {
    position: fixed;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 100%;
    max-width: 480px;
    background: rgba(255, 255, 255, 0.97);
    border-top: 1px solid #e5e7eb;
    /* Una sola fila siempre: tantas columnas como elementos, todas iguales */
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(0, 1fr);
    padding: 6px 2px calc(6px + env(safe-area-inset-bottom));
    z-index: 100;
  }

  .nav-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 3px;
    min-width: 0;
    min-height: 44px;
    justify-content: center;
    text-decoration: none;
    color: #6B6A63;
    padding: 6px 2px;
    border-radius: 8px;
    transition: color 0.15s;
  }

  .nav-item.active {
    color: var(--color-navy);
  }

  /* Punto indicador amber en ítem activo */
  .nav-item.active .nav-icon {
    position: relative;
  }
  .nav-item.active .nav-icon::after {
    content: '';
    position: absolute;
    bottom: -4px;
    left: 50%;
    transform: translateX(-50%);
    width: 4px;
    height: 4px;
    background: var(--color-amber-accent);
    border-radius: 50%;
  }

  /* Colores semánticos para ingreso y gasto cuando están activos */
  .nav-item.active .icon-income {
    color: var(--color-income);
  }
  .nav-item.active .icon-expense {
    color: var(--color-expense);
  }

  .nav-icon {
    width: 22px;
    height: 22px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .nav-icon svg {
    width: 20px;
    height: 20px;
  }

  .nav-label {
    font-family: var(--font-mono);
    font-size: 9px;
    font-weight: 500;
    letter-spacing: 0.02em;
    line-height: 1;
    max-width: 100%;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
</style>