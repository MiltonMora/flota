<div id="vehicle-edit-overlay" class="overlay" aria-hidden="true">
  <div class="modal" role="dialog" aria-modal="true" aria-labelledby="vedit-title">
    <div class="modal-handle"></div>

    <div class="modal-header">
      <div>
        <h2 id="vedit-title" class="modal-title">Editar vehículo</h2>
        <p class="modal-subtitle">modifica los datos de la unidad</p>
      </div>
      <button id="vedit-close" type="button" class="modal-close" aria-label="Cerrar">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M18 6L6 18M6 6l12 12" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/>
        </svg>
      </button>
    </div>

    <form id="vedit-form" novalidate>
      <div class="modal-body">
        <input type="hidden" id="vedit-id" />
        <input type="hidden" id="vedit-count" />

        <div class="field">
          <label for="vedit-plate">Matrícula *</label>
          <input id="vedit-plate" type="text" maxlength="12" autocapitalize="characters"
            class="field-input plate-input" autocomplete="off" aria-describedby="vedit-plate-msg" />
          <span id="vedit-plate-msg" class="field-msg"></span>
        </div>

        <div class="grid-2">
          <div class="field">
            <label for="vedit-brand">Marca *</label>
            <input id="vedit-brand" type="text" maxlength="50" class="field-input" aria-describedby="vedit-brand-msg" />
            <span id="vedit-brand-msg" class="field-msg"></span>
          </div>
          <div class="field">
            <label for="vedit-model">Modelo *</label>
            <input id="vedit-model" type="text" maxlength="50" class="field-input" aria-describedby="vedit-model-msg" />
            <span id="vedit-model-msg" class="field-msg"></span>
          </div>
        </div>

        <div class="field">
          <label for="vedit-year">Año *</label>
          <input id="vedit-year" type="number" inputmode="numeric" class="field-input"
            min="1900" max={new Date().getFullYear() + 1} aria-describedby="vedit-year-msg" />
          <span id="vedit-year-msg" class="field-msg"></span>
        </div>

        <div class="field no-border">
          <label for="vedit-description">Notas <span class="optional">· opcional</span></label>
          <input id="vedit-description" type="text" maxlength="300" class="field-input" />
        </div>
      </div>

      <div class="modal-actions">
        <button id="vedit-delete" type="button" class="btn-delete">Eliminar</button>
        <button id="vedit-submit" type="submit" class="btn-save">Guardar</button>
      </div>
    </form>
  </div>
</div>

<style>
  .overlay {
    position: fixed; inset: 0;
    background: rgba(20, 40, 80, 0.35);
    display: flex; align-items: flex-end;
    z-index: 200;
    opacity: 0; pointer-events: none;
    transition: opacity 0.2s ease;
  }
  .overlay.open { opacity: 1; pointer-events: all; }

  .modal {
    background: white; width: 100%; max-width: 480px;
    margin: 0 auto;
    border-radius: 24px 24px 0 0;
    padding-bottom: calc(1.25rem + env(safe-area-inset-bottom));
    transform: translateY(100%);
    transition: transform 0.25s cubic-bezier(0.32, 0.72, 0, 1);
  }
  .overlay.open .modal { transform: translateY(0); }

  .modal-handle { width: 32px; height: 3px; background: #B8D0EE; border-radius: 99px; margin: 14px auto 0; }

  .modal-header { display: flex; justify-content: space-between; align-items: flex-start; padding: 16px 18px 0; }

  .modal-title { font-family: var(--font-display); font-size: 22px; font-weight: 700; color: var(--color-navy); line-height: 1; }
  .modal-subtitle { font-family: var(--font-mono); font-size: 9px; color: #6B6A63; letter-spacing: 0.06em; margin-top: 4px; }

  .modal-close {
    width: 36px; height: 36px; border-radius: 50%;
    background: var(--color-navy-light); border: none;
    display: flex; align-items: center; justify-content: center;
    cursor: pointer; color: var(--color-navy);
    flex-shrink: 0; margin-top: 2px;
    transition: background 0.15s;
  }
  .modal-close:hover { background: #cce0f5; }


  .modal-body { padding: 4px 18px 0; display: flex; flex-direction: column; }

  .field { padding: 13px 0; border-bottom: 0.5px solid #f3f3f3; }
  .field.no-border { border-bottom: none; }

  .field label {
    font-family: var(--font-mono); font-size: 9px; color: #6B6A63;
    letter-spacing: 0.08em; text-transform: uppercase; display: block; margin-bottom: 5px;
  }
  .optional { color: var(--color-muted); font-size: 9px; text-transform: none; letter-spacing: 0; }

  .field-input {
    border: none; outline: none;
    font-family: var(--font-sans); font-size: 15px;
    color: var(--color-carbon); background: transparent; width: 100%; padding: 0;
  }
  .field-input::placeholder { color: #d1d5db; }

  .plate-input { font-family: var(--font-mono); font-size: 16px; letter-spacing: 0.12em; font-weight: 500; text-transform: uppercase; }

  .grid-2 { display: grid; grid-template-columns: 1fr 1fr; border-bottom: 0.5px solid #f3f3f3; }
  .grid-2 .field { border-bottom: none; padding: 13px 0; }
  .grid-2 .field:first-child { border-right: 0.5px solid #f3f3f3; padding-right: 16px; }
  .grid-2 .field:last-child { padding-left: 16px; }

  .modal-actions { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; padding: 14px 18px 0; }

  .btn-delete {
    padding: 13px; border-radius: 12px;
    font-family: var(--font-sans); font-size: 13px; font-weight: 600;
    background: var(--color-expense-light); color: var(--color-expense);
    border: none; cursor: pointer; transition: opacity 0.15s;
  }
  .btn-delete:hover { opacity: 0.8; }

  .btn-save {
    padding: 13px; border-radius: 12px;
    font-family: var(--font-sans); font-size: 13px; font-weight: 600;
    background: var(--color-navy); color: white;
    border: none; cursor: pointer;
    display: flex; align-items: center; justify-content: center; gap: 6px;
    transition: background 0.15s;
  }
  .btn-save:hover { background: var(--color-navy-mid); }
  .btn-save:disabled { opacity: 0.65; cursor: not-allowed; }


  .btn-delete, .btn-save { min-height: 48px; }
</style>
<script>
  import {
    api, toast, flashToast, setButtonState, setFieldError, confirmSheet, reloadWithLoading, wait,
  } from '@/scripts/ui';
  import { bindVehicleForm } from '@/scripts/vehicle-form';

  const overlay   = document.getElementById('vehicle-edit-overlay')!;
  const form      = document.getElementById('vedit-form') as HTMLFormElement;
  const btnClose  = document.getElementById('vedit-close')!;
  const btnDelete = document.getElementById('vedit-delete') as HTMLButtonElement;
  const btnSubmit = document.getElementById('vedit-submit') as HTMLButtonElement;

  const fields = {
    id:          document.getElementById('vedit-id')          as HTMLInputElement,
    count:       document.getElementById('vedit-count')       as HTMLInputElement,
    plate:       document.getElementById('vedit-plate')       as HTMLInputElement,
    brand:       document.getElementById('vedit-brand')       as HTMLInputElement,
    model:       document.getElementById('vedit-model')       as HTMLInputElement,
    year:        document.getElementById('vedit-year')        as HTMLInputElement,
    description: document.getElementById('vedit-description') as HTMLInputElement,
  };

  const vf = bindVehicleForm(form, fields);
  let busy = false;
  let originalPlate = '';

  document.addEventListener('open-vehicle-edit', (e: Event) => {
    const d = (e as CustomEvent).detail;
    fields.id.value          = d.id;
    fields.count.value       = d.txCount ?? '0';
    fields.plate.value       = d.plate;
    fields.brand.value       = d.brand;
    fields.model.value       = d.model;
    fields.year.value        = d.year;
    fields.description.value = d.description ?? '';
    originalPlate            = d.plate;

    vf.reset();
    setButtonState(btnSubmit, 'idle', 'Guardar');
    btnDelete.disabled = false;
    overlay.classList.add('open');
    overlay.setAttribute('aria-hidden', 'false');
    fields.plate.focus();
  });

  function closeModal() {
    if (busy) return;
    overlay.classList.remove('open');
    overlay.setAttribute('aria-hidden', 'true');
  }

  btnClose.addEventListener('click', closeModal);
  overlay.addEventListener('click', (e) => { if (e.target === overlay) closeModal(); });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && overlay.classList.contains('open')) closeModal();
  });

  // Eliminar: hoja de confirmación que exige escribir la matrícula
  btnDelete.addEventListener('click', async () => {
    if (busy) return;
    const id    = fields.id.value;
    const plate = originalPlate;
    const n     = Number(fields.count.value || 0);
    const impact = n === 0
      ? 'No tiene movimientos registrados.'
      : `Se borrarán también sus ${n} ${n === 1 ? 'movimiento' : 'movimientos'}.`;

    closeModal();
    const deleted = await confirmSheet({
      title:        `¿Eliminar el vehículo ${plate}?`,
      body:         `${impact} Esta acción no se puede deshacer.`,
      confirmLabel: 'Eliminar',
      busyLabel:    'Eliminando…',
      requireText:  n > 0 ? plate : undefined,
      onConfirm: async () => {
        const res = await api('/api/vehicles/delete', 'DELETE', { id });
        if (!res.ok) toast({ kind: 'error', title: 'No se pudo eliminar', body: res.error });
        return res.ok;
      },
    });

    if (deleted) {
      flashToast({ kind: 'success', title: 'Vehículo eliminado', body: plate });
      reloadWithLoading();
    }
  });

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (busy || !vf.validate()) return;

    busy = true;
    btnDelete.disabled = true;
    setButtonState(btnSubmit, 'loading', 'Guardando…');
    const res = await api('/api/vehicles/update', 'PUT', { id: fields.id.value, ...vf.data() });

    if (!res.ok) {
      busy = false;
      btnDelete.disabled = false;
      setButtonState(btnSubmit, 'idle', 'Guardar');
      if (res.status === 409) {
        setFieldError(fields.plate, 'Esa matrícula ya está registrada.');
        fields.plate.focus();
      } else {
        toast({ kind: 'error', title: res.offline ? 'Sin conexión' : 'No se pudo guardar', body: res.offline ? 'Inténtalo cuando vuelvas a tener red.' : res.error });
      }
      return;
    }

    setButtonState(btnSubmit, 'done', 'Guardado');
    await wait(600);
    flashToast({ kind: 'success', title: 'Vehículo actualizado', body: fields.plate.value });
    reloadWithLoading();
  });
</script>
