---
// Sin props, se controla desde el exterior con el evento 'open-vehicle-modal'
---

<div id="vehicle-modal-overlay" class="overlay" aria-hidden="true">
  <div class="modal" role="dialog" aria-modal="true" aria-labelledby="modal-title">

    <div class="modal-handle"></div>

    <div class="modal-header">
      <h2 id="modal-title" class="modal-title">Nuevo vehículo</h2>
      <button id="modal-close" type="button" class="modal-close" aria-label="Cerrar">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M18 6L6 18M6 6l12 12" stroke="#6B6A63" stroke-width="2" stroke-linecap="round"/>
        </svg>
      </button>
    </div>

    <form id="vehicle-form" novalidate>
      <div class="modal-body">
        <div class="field">
          <label for="v-plate">Matrícula *</label>
          <input id="v-plate" name="plate" type="text" maxlength="12" autocapitalize="characters"
            class="input plate-input" placeholder="ABC123" autocomplete="off" aria-describedby="v-plate-msg" />
          <span id="v-plate-msg" class="field-msg"></span>
        </div>

        <div class="grid-2">
          <div class="field">
            <label for="v-brand">Marca *</label>
            <input id="v-brand" name="brand" type="text" maxlength="50"
              class="input" placeholder="Toyota" aria-describedby="v-brand-msg" />
            <span id="v-brand-msg" class="field-msg"></span>
          </div>
          <div class="field">
            <label for="v-model">Modelo *</label>
            <input id="v-model" name="model" type="text" maxlength="50"
              class="input" placeholder="Corolla" aria-describedby="v-model-msg" />
            <span id="v-model-msg" class="field-msg"></span>
          </div>
        </div>

        <div class="field">
          <label for="v-year">Año *</label>
          <input id="v-year" name="year" type="number" inputmode="numeric"
            class="input" placeholder={String(new Date().getFullYear())}
            min="1900" max={new Date().getFullYear() + 1} aria-describedby="v-year-msg" />
          <span id="v-year-msg" class="field-msg"></span>
        </div>

        <div class="field">
          <label for="v-description">Notas <span class="optional">opcional</span></label>
          <textarea id="v-description" name="description" maxlength="300"
            class="input textarea" rows="2"
            placeholder="Color, uso, observaciones..."></textarea>
        </div>
      </div>

      <div class="modal-actions">
        <button id="modal-cancel" type="button" class="btn-cancel">Cancelar</button>
        <button id="modal-submit" type="submit" class="btn-save">Guardar</button>
      </div>
    </form>

  </div>
</div>

<style>
  .overlay {
    position: fixed;
    inset: 0;
    background: rgba(28, 63, 110, 0.45);
    display: flex;
    align-items: flex-end;
    z-index: 200;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s ease;
  }

  .overlay.open {
    opacity: 1;
    pointer-events: all;
  }

  .modal {
    background: white;
    width: 100%;
    max-width: 480px;
    margin: 0 auto;
    border-radius: 20px 20px 0 0;
    padding-bottom: calc(1rem + env(safe-area-inset-bottom));
    transform: translateY(100%);
    transition: transform 0.25s cubic-bezier(0.32, 0.72, 0, 1);
  }

  .overlay.open .modal {
    transform: translateY(0);
  }

  .modal-handle {
    width: 36px;
    height: 4px;
    background: #e5e7eb;
    border-radius: 99px;
    margin: 12px auto 0;
  }

  .modal-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 16px 18px 12px;
    border-bottom: 0.5px solid #f0f0f0;
  }

  .modal-title {
    font-family: var(--font-display);
    font-size: 22px;
    font-weight: 700;
    color: var(--color-navy);
  }

  .modal-close {
    width: 36px;
    height: 30px;
    border-radius: 50%;
    background: #F5F4F0;
    border: none;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background 0.15s;
  }
  .modal-close:hover { background: #e5e7eb; }


  .modal-body {
    padding: 14px 18px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 5px;
  }

  label {
    font-family: var(--font-mono);
    font-size: 9px;
    color: var(--color-navy-mid);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .optional {
    color: #6B6A63;
    font-size: 9px;
    text-transform: none;
    letter-spacing: 0;
  }

  .input {
    border: 0.5px solid #e5e7eb;
    border-radius: 8px;
    padding: 10px 12px;
    font-family: var(--font-sans);
    font-size: 14px;
    color: var(--color-carbon);
    background: #fafafa;
    outline: none;
    transition: border-color 0.15s, box-shadow 0.15s;
    width: 100%;
  }
  .input:focus {
    border-color: var(--color-navy-mid);
    box-shadow: 0 0 0 3px var(--color-navy-light);
    background: white;
  }

  .plate-input {
    font-family: var(--font-mono);
    font-size: 16px;
    letter-spacing: 0.12em;
    text-align: center;
    font-weight: 500;
    text-transform: uppercase;
  }

  .textarea {
    resize: none;
    min-height: 70px;
  }

  .grid-2 {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
  }

  .modal-actions {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
    padding: 4px 18px 0;
  }

  .btn-cancel {
    padding: 12px;
    border-radius: 9px;
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 600;
    background: #F5F4F0;
    color: #5F5E5A;
    border: none;
    cursor: pointer;
    transition: background 0.15s;
  }
  .btn-cancel:hover { background: #e5e7eb; }

  .btn-save {
    padding: 12px;
    border-radius: 9px;
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 600;
    background: var(--color-navy);
    color: white;
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    transition: background 0.15s;
  }
  .btn-save:hover   { background: var(--color-navy-mid); }
  .btn-save:disabled { opacity: 0.7; cursor: not-allowed; }


  .btn-cancel, .btn-save { min-height: 48px; }
</style>
<script>
  import { api, toast, flashToast, setButtonState, setFieldError, reloadWithLoading, wait } from '@/scripts/ui';
  import { bindVehicleForm } from '@/scripts/vehicle-form';

  const overlay   = document.getElementById('vehicle-modal-overlay')!;
  const form      = document.getElementById('vehicle-form') as HTMLFormElement;
  const btnClose  = document.getElementById('modal-close')!;
  const btnCancel = document.getElementById('modal-cancel')!;
  const btnSubmit = document.getElementById('modal-submit') as HTMLButtonElement;

  const inputs = {
    plate:       document.getElementById('v-plate')       as HTMLInputElement,
    brand:       document.getElementById('v-brand')       as HTMLInputElement,
    model:       document.getElementById('v-model')       as HTMLInputElement,
    year:        document.getElementById('v-year')        as HTMLInputElement,
    description: document.getElementById('v-description') as HTMLTextAreaElement,
  };

  const vf = bindVehicleForm(form, inputs);
  let busy = false;

  document.addEventListener('open-vehicle-modal', () => {
    setButtonState(btnSubmit, 'idle', 'Guardar');
    overlay.classList.add('open');
    overlay.setAttribute('aria-hidden', 'false');
    inputs.plate.focus();
  });

  function closeModal() {
    if (busy) return;
    overlay.classList.remove('open');
    overlay.setAttribute('aria-hidden', 'true');
    form.reset();
    vf.reset();
  }

  btnClose.addEventListener('click', closeModal);
  btnCancel.addEventListener('click', closeModal);
  overlay.addEventListener('click', (e) => { if (e.target === overlay) closeModal(); });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && overlay.classList.contains('open')) closeModal();
  });

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (busy || !vf.validate()) return;

    const data = vf.data();
    busy = true;
    setButtonState(btnSubmit, 'loading', 'Guardando…');
    const res = await api('/api/vehicles/create', 'POST', data);

    if (!res.ok) {
      busy = false;
      setButtonState(btnSubmit, 'idle', 'Guardar');
      if (res.status === 409) {
        setFieldError(inputs.plate, 'Esa matrícula ya está registrada.');
        inputs.plate.focus();
      } else {
        toast({ kind: 'error', title: res.offline ? 'Sin conexión' : 'No se pudo guardar', body: res.offline ? 'Inténtalo cuando vuelvas a tener red.' : res.error });
      }
      return;
    }

    setButtonState(btnSubmit, 'done', 'Guardado');
    await wait(600);
    flashToast({ kind: 'success', title: 'Vehículo añadido', body: `${data.plate.toUpperCase()} · ${data.brand} ${data.model}` });
    reloadWithLoading();
  });
</script>
