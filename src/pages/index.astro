---
// Página pública de presentación del servicio. Si ya hay sesión, los botones llevan al panel.
// Las capturas (public/landing/*.webp) son de la app con datos de demostración.
import Layout from '@/layouts/Layout.astro';
import { auth } from '@/lib/auth';

const session  = await auth.api.getSession({ headers: Astro.request.headers });
const loggedIn = !!session?.user;
const ctaHref  = loggedIn ? '/dashboard' : '/login';
const ctaLabel = loggedIn ? 'Ir a mi panel' : 'Iniciar sesión';

const slides = [
  { src: '/landing/app-inicio.webp',   alt: 'Pantalla de inicio de Flota Vial con el balance del mes, los vehículos y los últimos movimientos' },
  { src: '/landing/app-gasto.webp',    alt: 'Formulario para registrar un gasto de peaje desde el móvil' },
  { src: '/landing/app-resumen.webp',  alt: 'Informe con balance, ingresos, gastos y margen comparados con el período anterior' },
  { src: '/landing/app-informes.webp', alt: 'Gráfico semanal de ingresos y gastos y desglose de gastos por concepto' },
];


const showcase = [
  {
    kicker: 'registro',
    title: 'Anota un gasto en segundos',
    text: 'Desde el móvil, en la carretera: importe, concepto, vehículo y una nota. Los conceptos que ya usaste aparecen como sugerencia.',
    points: ['Ingresos y gastos por vehículo', 'Conceptos propios con notas', 'Funciona en cualquier navegador'],
    img: slides[1],
  },
  {
    kicker: 'resumen',
    title: 'Tu balance de un vistazo',
    text: 'Al entrar ves cuánto ingresó y cuánto salió en el mes, tus vehículos y los últimos movimientos.',
    points: ['Balance del período elegido', 'Accesos rápidos para registrar', 'Historial siempre a mano'],
    img: slides[0],
  },
  {
    kicker: 'informes',
    title: 'Informes que explican el número',
    text: 'Compara con el período anterior, mira la evolución semana a semana y descubre en qué concepto se va el dinero.',
    points: ['Filtra por vehículo y por uno o varios conceptos', 'Margen y rentabilidad por vehículo', 'Exporta a CSV para Excel'],
    img: slides[3],
  },
];

const features = [
  { icon: 'car',    title: 'Toda tu flota en un lugar', text: 'Cada vehículo con su matrícula y sus cuentas por separado.' },
  { icon: 'flow',   title: 'Ingresos y gastos al día',  text: 'Fletes, combustible, peajes o mantenimiento en segundos.' },
  { icon: 'tag',    title: 'Conceptos a tu medida',     text: 'Los habituales o los tuyos, con notas para el detalle.' },
  { icon: 'chart',  title: 'Informes claros',           text: 'Balance, margen y evolución comparados con el período anterior.' },
  { icon: 'csv',    title: 'Exporta a Excel',           text: 'Descarga tus movimientos en CSV para tu contador.' },
  { icon: 'shield', title: 'Acceso controlado',         text: 'Entras con Google y un administrador aprueba cada usuario.' },
];

const steps = [
  { title: 'Entra con Google',    text: 'Sin contraseñas nuevas: usa tu cuenta de Google.' },
  { title: 'Activamos tu acceso', text: 'El administrador revisa la solicitud y habilita tu cuenta.' },
  { title: 'Registra y analiza',  text: 'Añade tus vehículos, anota movimientos y consulta tus informes.' },
];
---

<Layout title="Flota Vial · Control de ingresos y gastos de tu flota">
  <div class="landing">

    <!-- ── Cabecera ── -->
    <header class="topbar" id="topbar">
      <div class="topbar-inner">
        <a href="/" class="brand" aria-label="Flota Vial, inicio">
          <span class="logo-mark" aria-hidden="true"><span class="logo-mark-inner"></span></span>
          <span class="brand-name">FLOTA VIAL</span>
        </a>
        <nav class="topnav" aria-label="Secciones">
          <a href="#como-funciona">Cómo funciona</a>
          <a href="#funciones">Funciones</a>
        </nav>
        <a href={ctaHref} class="btn btn-solid btn-sm">{ctaLabel}</a>
      </div>
    </header>

    <main>
      <!-- ── Hero ── -->
      <section class="hero">
        <div class="blob blob-a" aria-hidden="true"></div>
        <div class="blob blob-b" aria-hidden="true"></div>

        <div class="wrap hero-grid">
          <div class="hero-text">
            <p class="kicker anim-in">control vehicular</p>
            <h1 class="hero-title anim-in" style="--d: 80ms">
              Sabe cuánto gana <span class="hl">cada vehículo</span> de tu flota
            </h1>
            <p class="hero-sub anim-in" style="--d: 160ms">
              Ingresos y gastos de todos tus vehículos en una app pensada para el móvil, con informes que te dicen
              dónde se va el dinero y qué vehículo es más rentable.
            </p>
            <div class="hero-actions anim-in" style="--d: 240ms">
              <a href={ctaHref} class="btn btn-solid btn-lg">
                {loggedIn ? 'Ir a mi panel' : 'Empezar con Google'}
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </a>
              <a href="#como-funciona" class="btn btn-ghost btn-lg">Ver cómo funciona</a>
            </div>
            {!loggedIn && <p class="hero-note anim-in" style="--d: 320ms">Acceso con aprobación del administrador · sin instalar nada</p>}
          </div>

          <!-- Teléfono con capturas reales que van rotando -->
          <div class="hero-visual anim-in" style="--d: 200ms">
            <div class="phone" id="hero-phone">
              <div class="phone-notch" aria-hidden="true"></div>
              <div class="phone-screen" role="group" aria-roledescription="carrusel" aria-label="Capturas de la aplicación">
                {slides.map((s, i) => (
                  <img
                    src={s.src} alt={s.alt} width="640" height="1385"
                    class={`slide ${i === 0 ? 'is-active' : ''}`}
                    loading={i === 0 ? 'eager' : 'lazy'} decoding="async"
                    aria-hidden={i === 0 ? undefined : 'true'}
                  />
                ))}
              </div>
            </div>
            <div class="dots" role="tablist" aria-label="Elegir captura">
              {slides.map((s, i) => (
                <button type="button" class={`dot ${i === 0 ? 'is-active' : ''}`} role="tab"
                        aria-selected={i === 0 ? 'true' : 'false'} aria-label={`Captura ${i + 1}`} data-slide={i}></button>
              ))}
            </div>

            <div class="chip chip-a" aria-hidden="true">
              <span class="chip-icon up">↑</span>
              <span><small>Flete zona norte</small><b>+ $ 1.150.000</b></span>
            </div>
            <div class="chip chip-b" aria-hidden="true">
              <span class="chip-icon down">↓</span>
              <span><small>Peajes · Chusacá</small><b>− $ 16.100</b></span>
            </div>
            <div class="chip chip-c" aria-hidden="true">
              <span class="chip-icon amber">%</span>
              <span><small>Margen del mes</small><b>34 %</b></span>
            </div>
          </div>
        </div>
      </section>

      <!-- ── Cómo funciona: capturas reales ── -->
      <section id="como-funciona" class="wrap section">
        <div class="section-head reveal">
          <p class="kicker">cómo funciona</p>
          <h2 class="section-title">Del registro al informe, sin hojas de cálculo</h2>
        </div>

        {showcase.map((s, i) => (
          <article class={`showcase ${i % 2 ? 'is-reverse' : ''}`}>
            <div class="showcase-media reveal" data-from={i % 2 ? 'right' : 'left'}>
              <div class="phone phone-sm">
                <div class="phone-notch" aria-hidden="true"></div>
                <div class="phone-screen">
                  <img src={s.img.src} alt={s.img.alt} width="640" height="1385" loading="lazy" decoding="async" />
                </div>
              </div>
            </div>
            <div class="showcase-text reveal" data-from={i % 2 ? 'left' : 'right'}>
              <p class="kicker"><span class="step-tag">{String(i + 1).padStart(2, '0')}</span> {s.kicker}</p>
              <h3 class="showcase-title">{s.title}</h3>
              <p class="showcase-sub">{s.text}</p>
              <ul class="checks" role="list">
                {s.points.map((p) => (
                  <li>
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="10" fill="#EAF3DE"/><path d="M7.5 12.5l3 3 6-6.5" stroke="#3B6D11" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    {p}
                  </li>
                ))}
              </ul>
            </div>
          </article>
        ))}
      </section>

      <!-- ── Funciones ── -->
      <section id="funciones" class="section section-tint">
        <div class="wrap">
          <div class="section-head reveal">
            <p class="kicker">funciones</p>
            <h2 class="section-title">Todo lo que necesitas para llevar las cuentas</h2>
          </div>
          <ul class="features" role="list">
            {features.map((f, i) => (
              <li class="feature reveal" style={`--d: ${i * 70}ms`}>
                <span class="feature-icon" aria-hidden="true">
                  {f.icon === 'car' && <svg viewBox="0 0 24 24" fill="none"><path d="M5 16l1-5h12l1 5M7 16h10" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/><circle cx="8" cy="18" r="1.5" fill="currentColor"/><circle cx="16" cy="18" r="1.5" fill="currentColor"/></svg>}
                  {f.icon === 'flow' && <svg viewBox="0 0 24 24" fill="none"><path d="M8 19V5M4 9l4-4 4 4M16 5v14M12 15l4 4 4-4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>}
                  {f.icon === 'tag' && <svg viewBox="0 0 24 24" fill="none"><path d="M3 12V4h8l9 9-8 8-9-9z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><circle cx="7.5" cy="8.5" r="1.5" fill="currentColor"/></svg>}
                  {f.icon === 'chart' && <svg viewBox="0 0 24 24" fill="none"><path d="M4 20V10M10 20V4M16 20v-7M22 20H2" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>}
                  {f.icon === 'csv' && <svg viewBox="0 0 24 24" fill="none"><path d="M12 4v11M7 10l5 5 5-5M5 19h14" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>}
                  {f.icon === 'shield' && <svg viewBox="0 0 24 24" fill="none"><path d="M12 3l8 3v6c0 4.5-3.4 8.2-8 9-4.6-.8-8-4.5-8-9V6l8-3z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><path d="M8.5 12l2.5 2.5 4.5-5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>}
                </span>
                <h3 class="feature-title">{f.title}</h3>
                <p class="feature-text">{f.text}</p>
              </li>
            ))}
          </ul>
        </div>
      </section>

      <!-- ── Cómo empezar ── -->
      <section class="wrap section">
        <div class="section-head reveal">
          <p class="kicker">cómo empezar</p>
          <h2 class="section-title">En tres pasos</h2>
        </div>
        <ol class="steps reveal" role="list">
          {steps.map((s, i) => (
            <li class="step" style={`--d: ${i * 160}ms`}>
              <span class="step-num" aria-hidden="true">{i + 1}</span>
              <h3 class="step-title">{s.title}</h3>
              <p class="step-text">{s.text}</p>
            </li>
          ))}
        </ol>
      </section>

      <!-- ── Llamada final ── -->
      <section class="wrap">
        <div class="cta reveal">
          <div class="cta-text">
            <h2 class="cta-title">Pon orden en las cuentas de tu flota</h2>
            <p class="cta-sub">Funciona en el móvil y en el ordenador, sin instalar nada.</p>
            <a href={ctaHref} class="btn btn-amber btn-lg">{loggedIn ? 'Ir a mi panel' : 'Iniciar sesión con Google'}</a>
          </div>
          <img class="cta-img" src="/landing/app-resumen.webp" alt="" width="640" height="1385" loading="lazy" decoding="async" />
        </div>
      </section>
    </main>

    <footer class="wrap footer">
      <span>© {new Date().getFullYear()} Flota Vial</span>
      <a href={ctaHref}>{ctaLabel}</a>
    </footer>
  </div>
</Layout>

<style>
  .landing { min-height: 100dvh; background: var(--color-asphalt); color: var(--color-carbon); overflow-x: clip; }
  .wrap { max-width: 1120px; margin: 0 auto; padding-left: 16px; padding-right: 16px; }

  /* ── Cabecera fija ── */
  .topbar { position: sticky; top: 0; z-index: 40; transition: background-color 0.25s, box-shadow 0.25s; }
  .topbar.is-scrolled { background: rgba(245, 244, 240, 0.9); backdrop-filter: blur(10px); box-shadow: 0 1px 0 rgba(0, 0, 0, 0.06); }
  .topbar-inner { max-width: 1120px; margin: 0 auto; padding: 12px 16px; display: flex; align-items: center; gap: 12px; }
  .brand { display: inline-flex; align-items: center; gap: 10px; text-decoration: none; margin-right: auto; }
  .logo-mark { width: 34px; height: 34px; border-radius: 8px; background: var(--color-navy); display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
  .logo-mark-inner { width: 16px; height: 10px; border: 2px solid var(--color-amber-accent); border-radius: 2px; }
  .brand-name { font-family: var(--font-display); font-size: 22px; font-weight: 700; color: var(--color-navy); letter-spacing: 0.03em; }
  .topnav { display: none; gap: 22px; }
  .topnav a { color: var(--color-muted-strong); text-decoration: none; font-size: 14px; font-weight: 500; }
  .topnav a:hover { color: var(--color-navy); }

  /* ── Botones ── */
  .btn {
    display: inline-flex; align-items: center; justify-content: center; gap: 8px; min-height: 46px; padding: 0 20px;
    border-radius: 12px; font-family: var(--font-sans); font-size: 15px; font-weight: 600; text-decoration: none; white-space: nowrap;
    transition: background-color 0.15s, transform 0.15s, box-shadow 0.15s;
  }
  .btn:focus-visible { outline: 3px solid rgba(42, 95, 165, 0.4); outline-offset: 2px; }
  .btn:hover { transform: translateY(-2px); }
  .btn-sm { min-height: 40px; padding: 0 14px; font-size: 14px; }
  .btn-lg { min-height: 52px; padding: 0 24px; font-size: 16px; }
  .btn-solid { background: var(--color-navy); color: white; box-shadow: 0 8px 20px rgba(28, 63, 110, 0.25); }
  .btn-solid:hover { background: var(--color-navy-mid); }
  .btn-solid svg { transition: transform 0.2s; }
  .btn-solid:hover svg { transform: translateX(3px); }
  .btn-ghost { color: var(--color-navy); border: 1.5px solid var(--color-navy); background: rgba(255, 255, 255, 0.7); }
  .btn-ghost:hover { background: var(--color-navy-light); }
  .btn-amber { background: var(--color-amber-accent); color: var(--color-navy); box-shadow: 0 8px 20px rgba(245, 166, 35, 0.35); }

  .kicker { margin: 0 0 10px; font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.08em; color: var(--color-navy-mid); }

  /* ── Hero ── */
  .hero { position: relative; padding-top: 24px; overflow: hidden; }
  .blob { position: absolute; border-radius: 50%; filter: blur(60px); opacity: 0.55; pointer-events: none; animation: drift 14s ease-in-out infinite alternate; }
  .blob-a { width: 420px; height: 420px; background: #CFE3F7; top: -120px; right: -120px; }
  .blob-b { width: 340px; height: 340px; background: #FBE3BA; bottom: 40px; left: -140px; animation-delay: -6s; }
  @keyframes drift { to { transform: translate(40px, 30px) scale(1.08); } }

  .hero-grid { position: relative; display: grid; gap: 40px; align-items: center; padding-bottom: 32px; }
  .hero-title { margin: 0; font-family: var(--font-display); font-size: clamp(2.6rem, 9vw, 4.4rem); font-weight: 700; line-height: 0.96; color: var(--color-navy); text-wrap: balance; }
  .hl { position: relative; z-index: 0; white-space: nowrap; }
  .hl::after {
    content: ''; position: absolute; left: -2px; right: -2px; bottom: 0.06em; height: 0.28em; z-index: -1;
    background: var(--color-amber-accent); opacity: 0.55; border-radius: 4px;
    transform-origin: left; transform: scaleX(0); animation: underline 0.9s 0.6s cubic-bezier(0.2, 0.8, 0.2, 1) forwards;
  }
  @keyframes underline { to { transform: scaleX(1); } }
  .hero-sub { margin: 18px 0 0; font-size: 17px; line-height: 1.6; color: var(--color-muted-strong); max-width: 34rem; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 26px; }
  .hero-note { margin: 14px 0 0; font-family: var(--font-mono); font-size: 11px; color: var(--color-muted); }

  .anim-in { opacity: 0; transform: translateY(18px); animation: rise 0.7s var(--d, 0ms) cubic-bezier(0.2, 0.8, 0.2, 1) forwards; }
  @keyframes rise { to { opacity: 1; transform: none; } }

  /* Teléfono */
  .hero-visual { position: relative; display: flex; flex-direction: column; align-items: center; gap: 14px; padding: 10px 0 0; }
  .phone {
    position: relative; width: min(78vw, 300px); aspect-ratio: 640 / 1385; border-radius: 40px; padding: 10px;
    background: #141821; box-shadow: 0 30px 70px rgba(28, 63, 110, 0.28), inset 0 0 0 2px #2b3140;
  }
  .phone-sm { width: min(70vw, 270px); }
  .phone-notch { position: absolute; top: 14px; left: 50%; width: 34%; height: 20px; transform: translateX(-50%); background: #141821; border-radius: 0 0 14px 14px; z-index: 2; }
  .phone-screen { position: relative; width: 100%; height: 100%; border-radius: 30px; overflow: hidden; background: var(--color-asphalt); }
  .phone-screen img { display: block; width: 100%; height: 100%; object-fit: cover; object-position: top; }
  #hero-phone { animation: float 6s ease-in-out infinite; }
  @keyframes float { 50% { transform: translateY(-10px); } }

  .slide { position: absolute; inset: 0; opacity: 0; transform: scale(1.03); transition: opacity 0.7s ease, transform 1.2s ease; }
  .slide.is-active { opacity: 1; transform: none; }

  .dots { display: flex; gap: 8px; }
  .dot { width: 8px; height: 8px; padding: 0; border: none; border-radius: 99px; background: #CFCDC5; cursor: pointer; transition: width 0.3s, background-color 0.3s; }
  .dot.is-active { width: 26px; background: var(--color-navy); }
  .dot:focus-visible { outline: 2px solid var(--color-navy-mid); outline-offset: 3px; }

  .chip {
    position: absolute; display: flex; align-items: center; gap: 10px; padding: 9px 12px 9px 9px; border-radius: 14px;
    background: rgba(255, 255, 255, 0.95); box-shadow: 0 12px 30px rgba(0, 0, 0, 0.12); font-size: 12px; white-space: nowrap;
    animation: float 5s ease-in-out infinite;
  }
  .chip span:last-child { display: flex; flex-direction: column; line-height: 1.25; }
  .chip small { font-family: var(--font-mono); font-size: 9px; color: var(--color-muted); }
  .chip b { font-family: var(--font-mono); font-size: 13px; font-weight: 500; color: var(--color-carbon); }
  .chip-icon { width: 30px; height: 30px; border-radius: 9px; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 15px; }
  .chip-icon.up    { background: var(--color-income-light); color: var(--color-income); }
  .chip-icon.down  { background: var(--color-expense-light); color: var(--color-expense); }
  .chip-icon.amber { background: var(--color-amber-light); color: #8A5A0B; font-size: 13px; }
  .chip-a { top: 12%; left: -2%; animation-delay: -1s; }
  .chip-b { top: 46%; right: -4%; animation-delay: -2.5s; }
  .chip-c { bottom: 16%; left: 0; animation-delay: -4s; }

  /* ── Secciones ── */
  .section { padding-top: 72px; padding-bottom: 24px; }
  .section-tint { margin-top: 48px; padding-bottom: 72px; background: white; }
  .section-head { margin-bottom: 28px; }
  .section-title { margin: 0; font-family: var(--font-display); font-size: clamp(2rem, 6vw, 2.8rem); font-weight: 700; line-height: 1.02; color: var(--color-navy); max-width: 38rem; text-wrap: balance; }

  /* Showcase */
  .showcase { display: grid; gap: 28px; align-items: center; padding: 28px 0; }
  .showcase-media { display: flex; justify-content: center; position: relative; }
  .showcase-media::before {
    content: ''; position: absolute; width: 78%; aspect-ratio: 1; top: 50%; left: 50%; transform: translate(-50%, -50%);
    border-radius: 50%; background: radial-gradient(circle, #DCEBFA 0%, rgba(220, 235, 250, 0) 70%);
  }
  .showcase .phone { z-index: 1; }
  .step-tag { display: inline-block; padding: 2px 7px; margin-right: 4px; border-radius: 6px; background: var(--color-amber-light); color: #8A5A0B; }
  .showcase-title { margin: 0; font-family: var(--font-display); font-size: clamp(1.8rem, 5vw, 2.4rem); font-weight: 700; line-height: 1.05; color: var(--color-navy); }
  .showcase-sub { margin: 12px 0 0; font-size: 16px; line-height: 1.6; color: var(--color-muted-strong); max-width: 30rem; }
  .checks { list-style: none; margin: 18px 0 0; padding: 0; display: flex; flex-direction: column; gap: 10px; }
  .checks li { display: flex; align-items: center; gap: 10px; font-size: 15px; font-weight: 500; }
  .checks svg { flex-shrink: 0; }

  /* Funciones */
  .features { list-style: none; margin: 0; padding: 0; display: grid; gap: 12px; }
  .feature { background: var(--color-asphalt); border-radius: 16px; padding: 20px; transition: transform 0.2s, box-shadow 0.2s, background-color 0.2s; }
  .feature:hover { transform: translateY(-4px); background: white; box-shadow: 0 16px 36px rgba(28, 63, 110, 0.12); }
  .feature-icon { width: 44px; height: 44px; border-radius: 12px; background: var(--color-navy); color: var(--color-amber-accent); display: flex; align-items: center; justify-content: center; transition: transform 0.3s; }
  .feature:hover .feature-icon { transform: rotate(-8deg) scale(1.06); }
  .feature-icon svg { width: 22px; height: 22px; }
  .feature-title { margin: 14px 0 4px; font-family: var(--font-sans); font-size: 16px; font-weight: 600; color: var(--color-carbon); }
  .feature-text { margin: 0; font-size: 14px; line-height: 1.5; color: var(--color-muted-strong); }

  /* Pasos con línea que se dibuja */
  .steps { list-style: none; margin: 0; padding: 0; display: grid; gap: 14px; position: relative; }
  .step { position: relative; background: white; border: 0.5px solid #e5e7eb; border-radius: 16px; padding: 20px; }
  .step-num {
    width: 40px; height: 40px; border-radius: 50%; background: var(--color-amber-accent); color: var(--color-navy);
    font-family: var(--font-display); font-size: 20px; font-weight: 700; display: flex; align-items: center; justify-content: center;
    box-shadow: 0 0 0 6px var(--color-amber-light);
  }
  .step-title { margin: 14px 0 4px; font-family: var(--font-sans); font-size: 16px; font-weight: 600; }
  .step-text { margin: 0; font-size: 14px; line-height: 1.5; color: var(--color-muted-strong); }

  /* Llamada final */
  .cta {
    position: relative; margin-top: 72px; background: linear-gradient(135deg, var(--color-navy) 0%, #24508a 100%); color: white;
    border-radius: 24px; padding: 36px 22px 0; overflow: hidden; display: grid; gap: 24px;
  }
  .cta-title { margin: 0; font-family: var(--font-display); font-size: clamp(2rem, 6vw, 2.8rem); font-weight: 700; line-height: 1.02; text-wrap: balance; }
  .cta-sub { margin: 10px 0 20px; font-size: 16px; color: rgba(255, 255, 255, 0.82); }
  .cta-img { width: min(70%, 260px); justify-self: center; border-radius: 22px 22px 0 0; box-shadow: 0 -10px 40px rgba(0, 0, 0, 0.25); transform: translateY(12px); }

  .footer {
    display: flex; justify-content: space-between; align-items: center; gap: 12px; padding-top: 28px; padding-bottom: 32px;
    font-family: var(--font-mono); font-size: 11px; color: var(--color-muted);
  }
  .footer a { color: var(--color-navy); }

  /* Aparición al hacer scroll (solo si el script está activo) */
  :global(.js) .reveal { opacity: 0; transform: translateY(28px); transition: opacity 0.7s var(--d, 0ms), transform 0.7s var(--d, 0ms) cubic-bezier(0.2, 0.8, 0.2, 1); }
  :global(.js) .reveal[data-from='left']  { transform: translateX(-36px); }
  :global(.js) .reveal[data-from='right'] { transform: translateX(36px); }
  :global(.js) .reveal.is-visible { opacity: 1; transform: none; }
  :global(.js) .steps .step { opacity: 0; transform: translateY(20px); transition: opacity 0.6s var(--d), transform 0.6s var(--d); }
  :global(.js) .steps.is-visible .step { opacity: 1; transform: none; }

  @media (min-width: 720px) {
    .wrap, .topbar-inner { padding-left: 32px; padding-right: 32px; }
    .topnav { display: flex; }
    .hero { padding-top: 40px; }
    .hero-grid { grid-template-columns: 1.1fr 0.9fr; padding-bottom: 56px; }
    .phone { width: 300px; }
    .phone-sm { width: 270px; }
    .chip-a { left: -6%; }
    .chip-b { right: -2%; }
    .showcase { grid-template-columns: 1fr 1fr; gap: 56px; padding: 40px 0; }
    .showcase.is-reverse .showcase-media { order: 2; }
    .features { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .steps { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .steps::before {
      content: ''; position: absolute; top: 40px; left: 12%; right: 12%; height: 2px; z-index: 0;
      background: repeating-linear-gradient(90deg, var(--color-amber-accent) 0 10px, transparent 10px 18px);
    }
    .step { z-index: 1; }
    .cta { grid-template-columns: 1.2fr 0.8fr; padding: 48px 48px 0; align-items: end; }
    .cta-text { padding-bottom: 48px; }
  }
  @media (min-width: 1000px) {
    .features { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }

  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after { animation: none !important; transition: none !important; }
    .anim-in, :global(.js) .reveal, :global(.js) .steps .step { opacity: 1 !important; transform: none !important; }
    .hl::after { transform: none; }
  }
</style>

<script>
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  document.documentElement.classList.add('js');

  // Cabecera con fondo al hacer scroll
  const topbar = document.getElementById('topbar')!;
  const onScroll = () => topbar.classList.toggle('is-scrolled', window.scrollY > 8);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  // Aparición de secciones al entrar en pantalla
  const reveals = document.querySelectorAll('.reveal');
  if (reduceMotion || !('IntersectionObserver' in window)) {
    reveals.forEach((el) => el.classList.add('is-visible'));
  } else {
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) {
        if (e.isIntersecting) { e.target.classList.add('is-visible'); io.unobserve(e.target); }
      }
    }, { threshold: 0.18, rootMargin: '0px 0px -40px 0px' });
    reveals.forEach((el) => io.observe(el));
  }

  // Carrusel de capturas del teléfono
  const slides = [...document.querySelectorAll<HTMLImageElement>('#hero-phone .slide')];
  const dots   = [...document.querySelectorAll<HTMLButtonElement>('.dots .dot')];
  let current = 0;
  let timer: number | undefined;
  const show = (i: number) => {
    current = (i + slides.length) % slides.length;
    slides.forEach((s, k) => {
      s.classList.toggle('is-active', k === current);
      if (k === current) s.removeAttribute('aria-hidden'); else s.setAttribute('aria-hidden', 'true');
    });
    dots.forEach((d, k) => { d.classList.toggle('is-active', k === current); d.setAttribute('aria-selected', String(k === current)); });
  };
  const start = () => { if (!reduceMotion) timer = window.setInterval(() => show(current + 1), 3800); };
  const stop  = () => window.clearInterval(timer);
  dots.forEach((d) => d.addEventListener('click', () => { stop(); show(Number(d.dataset.slide)); start(); }));
  document.addEventListener('visibilitychange', () => (document.hidden ? stop() : start()));
  start();
</script>
