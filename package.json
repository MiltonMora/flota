{
  "name": "vehicle-control-app",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "build:cf": "DEPLOY_TARGET=cloudflare astro build",
    "preview:cf": "npm run build:cf && wrangler dev",
    "deploy:cf": "npm run build:cf && wrangler deploy",
    "astro": "astro",
    "db:generate": "drizzle-kit generate --config=src/drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config=src/drizzle.config.ts",
    "db:studio": "drizzle-kit studio --config=src/drizzle.config.ts",
    "start": "node --env-file-if-exists=.env ./dist/server/entry.mjs",
    "check": "astro check",
    "dev:login": "node scripts/dev-login.mjs"
  },
  "dependencies": {
    "@astrojs/cloudflare": "~13.7.0",
    "@astrojs/node": "^10.1.0",
    "@libsql/client": "^0.17.3",
    "@tailwindcss/vite": "^4.2.4",
    "astro": "^6.2.1",
    "better-auth": "^1.6.9",
    "drizzle-orm": "^0.45.2",
    "nanoid": "^5.1.11",
    "tailwindcss": "^4.2.4",
    "zod": "^4.4.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "drizzle-kit": "^0.31.10",
    "typescript": "^6.0.3",
    "wrangler": "^4.155.0"
  },
  "overrides": {
    "vite": "^7"
  }
}
